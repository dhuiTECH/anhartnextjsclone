modules = ["nodejs-20", "web", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["libwebp"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dev"

[[workflows.workflow]]
name = "dev"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd next-app && npm run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 33433
externalPort = 3000

[[ports]]
localPort = 35957
externalPort = 3002

[[ports]]
localPort = 38575
externalPort = 5000

[[ports]]
localPort = 38591
externalPort = 6800

[[ports]]
localPort = 38745
externalPort = 8000

[[ports]]
localPort = 40209
externalPort = 5173

[[ports]]
localPort = 40325
externalPort = 8080

[[ports]]
localPort = 41225
externalPort = 3003

[[ports]]
localPort = 45123
externalPort = 3001

[[ports]]
localPort = 45309
externalPort = 6000

[[ports]]
localPort = 45685
externalPort = 4200

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd next-app && npm run start"]
build = ["bash", "-c", "cd next-app && npm install && npm run build"]
